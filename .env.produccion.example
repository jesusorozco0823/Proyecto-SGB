# Copia este archivo y nómbralo .env.produccion
# No reemplaces el .env que ya usa el sitio en tu computador.
# .env.produccion no se sube a GitHub.

# Pega aquí la dirección que te da Neon. Debe incluir sslmode=require.
# El nombre del servidor no puede ser localhost.
DATABASE_URL=

# Datos del primer superadministrador del sitio público.
# Usa tu documento real y una contraseña distinta a la de desarrollo.
ADMIN_DOCUMENT=
ADMIN_DISPLAY_NAME=
ADMIN_PASSWORD=
ADMIN_PHONE=
